<Window x:Class="Skippy.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skippy" Width="840" SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="Breathe" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CaptureText" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.7"/>
        </Storyboard>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" Y="12"/>
        </Grid.RenderTransform>

        <!-- soft accent glow behind everything -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.75" RadiusY="0.9">
                    <GradientStop Color="#2A2050" Offset="0"/>
                    <GradientStop Color="#00100E16" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.6" RadiusY="0.7">
                    <GradientStop Color="#2A1430" Offset="0"/>
                    <GradientStop Color="#00100E16" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <DockPanel>
            <!-- ===== title bar ===== -->
            <Grid DockPanel.Dock="Top" Height="58" Margin="20,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="Logo" Width="26" Height="26" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="Skippy" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,14,1"/>
                <Border Grid.Column="2" x:Name="StatusPill" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="12" Padding="10,4,12,4"
                        Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="StatusPill_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Recording" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="VersionText" Text="v0.1.0" FontSize="11.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="UpdateButton" Style="{StaticResource Ghost}" Padding="11,5" FontSize="12" Click="Update_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UpdateIcon" Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="UpdateText" Text="Check for updates" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize"/>
                    <Button Style="{StaticResource Caption}" Content="&#xE8BB;" Tag="close" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close (Skippy keeps running in the tray)"/>
                </StackPanel>
            </Grid>

            <!-- ===== content ===== -->
            <Grid Margin="20,2,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== left column ===== -->
                <StackPanel Grid.Column="0">

                    <!-- hero: hotkey + buffer ring -->
                    <Border CornerRadius="16" Padding="20,18" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#261C4A" Offset="0"/>
                                <GradientStop Color="#2A1533" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#665BD0" Offset="0"/>
                                <GradientStop Color="#8F3A69" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="INSTANT REPLAY" FontSize="11.5" FontWeight="SemiBold" Foreground="#B9A6FF" Margin="0,0,0,12"/>
                                <Border x:Name="KeysArea" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="KeysArea_Click" ToolTip="Click, then press a new shortcut">
                                    <Grid MinHeight="46">
                                        <WrapPanel x:Name="Keycaps" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CaptureText" Text="Press a new shortcut…" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                                                   Foreground="#D8CCFF" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="HeroSub" Text="saves the last minute" Foreground="{StaticResource Text2}" FontSize="13.5" Margin="0,12,0,0"/>
                                <TextBlock x:Name="HotkeyHint" Text="Click the keys to change the shortcut" Foreground="{StaticResource Text3}" FontSize="11.5" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Width="104" Height="104" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Ellipse Stroke="#33FFFFFF" StrokeThickness="7" Margin="3.5"/>
                                <Path x:Name="RingArc" Stroke="{StaticResource Accent}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Effect><DropShadowEffect Color="#A050FF" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/></Path.Effect>
                                </Path>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="RingText" Text="0:00" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="buffered" FontSize="10.5" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="EngineInfo" Text=" " Foreground="{StaticResource Text3}" FontSize="11.5"
                                       Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- clip -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="CLIP"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Length"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentTrack}">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="len" x:Name="Len30" Content="30 s" Tag="30" Checked="Length_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="len" x:Name="Len60" Content="1 min" Tag="60" Checked="Length_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="len" x:Name="Len120" Content="2 min" Tag="120" Checked="Length_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="len" x:Name="Len180" Content="3 min" Tag="180" Checked="Length_Checked"/>
                                    </UniformGrid>
                                </Border>
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Frame rate"/>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SegmentTrack}">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="fps" x:Name="Fps30" Content="30 fps" Tag="30" Checked="Fps_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="fps" x:Name="Fps60" Content="60 fps" Tag="60" Checked="Fps_Checked"/>
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- saving -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="SAVING"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Control}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#B9A6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                    <TextBlock x:Name="FolderName" Text="Skippy" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="FolderPath" Text="" FontSize="11.5" Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Ghost}" Content="Change" Click="ChangeFolder_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource Ghost}" Click="OpenFolder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Open folder"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,14,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Last clip" Foreground="{StaticResource Text3}" FontSize="12" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" x:Name="LastClip" Text="none yet" FontSize="12" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" x:Name="ShowClip" Style="{StaticResource Link}" Content="Show" Click="ShowClip_Click" Margin="10,0,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== right column ===== -->
                <StackPanel Grid.Column="2">

                    <!-- audio -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="AUDIO"/>

                            <Grid Margin="0,0,0,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Microphone"/>
                                </StackPanel>
                                <TextBlock x:Name="MicState" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                            </Grid>
                            <ComboBox x:Name="MicBox" Style="{StaticResource Combo}" SelectionChanged="Mic_Changed" DropDownOpened="Audio_DropDownOpened"/>
                            <Border Height="4" CornerRadius="2" Background="#241F2C" Margin="2,8,2,0" x:Name="MicTrack">
                                <Border x:Name="MicMeter" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource AccentH}"/>
                            </Border>

                            <Grid Margin="0,18,0,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Headset / game audio"/>
                                </StackPanel>
                                <TextBlock x:Name="OutState" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                            </Grid>
                            <ComboBox x:Name="OutBox" Style="{StaticResource Combo}" SelectionChanged="Out_Changed" DropDownOpened="Audio_DropDownOpened"/>
                            <Border Height="4" CornerRadius="2" Background="#241F2C" Margin="2,8,2,0" x:Name="OutTrack">
                                <Border x:Name="OutMeter" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource AccentH}"/>
                            </Border>

                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,18,0,14"/>
                            <CheckBox x:Name="SoundSwitch" Style="{StaticResource Switch}" Checked="Sound_Changed" Unchecked="Sound_Changed">
                                <StackPanel>
                                    <TextBlock Text="Play a sound when a clip is saved" FontSize="13"/>
                                    <TextBlock Text="A short chime once the file is written" FontSize="11.5" Foreground="{StaticResource Text3}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- screen -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="SCREEN"/>
                                <TextBlock Text="click a screen to record it" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource Text3}"/>
                            </Grid>
                            <Border CornerRadius="10" Background="#120F17" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Height="132" x:Name="MapFrame">
                                <Canvas x:Name="MonitorMap" ClipToBounds="True"/>
                            </Border>
                            <TextBlock x:Name="MonitorInfo" Margin="2,10,0,0" FontSize="12.5" Foreground="{StaticResource Text2}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
