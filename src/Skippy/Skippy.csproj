<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>Skippy</AssemblyName>
    <RootNamespace>Skippy</RootNamespace>
    <Product>Skippy</Product>
    <AssemblyTitle>Skippy</AssemblyTitle>
    <Description>Skippy instant replay</Description>
    <ApplicationIcon>Skippy.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup>
    <!-- GitHub "owner/repo" whose releases the Check for updates button reads -->
    <UpdateRepo>fragileyazeed-cmd/Skippy</UpdateRepo>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
    <Resource Include="Skippy.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

</Project>
